{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Felipegalind0/foss-earth/src/scenes/foss-earth-scene-1.schema.json",
  "title": "foss-earth-scene, version 1",
  "description": "A FOSS Earth scene: panorama assets, where they are placed and how they link. The schema checks the shape of each record. validateScene in foss-earth/scenes also checks what a schema cannot: unique ids, that references exist, the 2:1 equirectangular ratio, at least one preview cube per asset, required extensions, and the size limits. See docs/scenes/format.md.",
  "type": "object",
  "required": ["format", "version", "id", "revision", "title", "assets", "entities"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "foss-earth-scene" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "revision": { "$ref": "#/$defs/text", "description": "Changes on any editorial or placement change." },
    "title": { "$ref": "#/$defs/text" },
    "requiredExtensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/extensionKey" },
      "description": "Keys of \"extensions\" a loader must implement to show this scene."
    },
    "extensions": { "$ref": "#/$defs/extensions" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "initialPanorama": { "$ref": "#/$defs/id", "description": "A suggested destination. Loading a scene still opens its overview." },
    "overview": { "$ref": "#/$defs/overview" },
    "markerStyle": { "$ref": "#/$defs/markerStyle", "description": "How every orb looks, unless its marker's style overrides it." }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "Case-sensitive ASCII, unique in its scope."
    },
    "text": { "type": "string", "pattern": "\\S" },
    "extensionKey": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[A-Za-z0-9_-]+)+$",
      "description": "An owner, then a name: \"owner.name\"."
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced data for later features. Never executed.",
      "propertyNames": { "$ref": "#/$defs/extensionKey" },
      "additionalProperties": { "type": "object" }
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "http(s), absolute or relative to the manifest's final response URL; no credentials."
    },
    "headingDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360, "description": "Clockwise from true north." },
    "pitchDeg": { "type": "number", "minimum": -90, "maximum": 90, "description": "Positive above the horizon." },
    "verticalFovDeg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
    "longitudeDeg": { "type": "number", "minimum": -180, "exclusiveMaximum": 180 },
    "latitudeDeg": { "type": "number", "minimum": -90, "maximum": 90 },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "height": {
      "description": "Metres above the WGS84 ellipsoid, or null when unknown. Never a silent zero.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["meters", "datum"],
          "additionalProperties": false,
          "properties": {
            "meters": { "type": "number" },
            "datum": { "const": "WGS84-ellipsoid" },
            "source": { "$ref": "#/$defs/text", "description": "Where the value came from, and any conversion made while preparing it." },
            "uncertaintyMeters": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "view": {
      "type": "object",
      "required": ["headingDeg", "pitchDeg", "verticalFovDeg"],
      "additionalProperties": false,
      "properties": {
        "headingDeg": { "$ref": "#/$defs/headingDeg" },
        "pitchDeg": { "$ref": "#/$defs/pitchDeg" },
        "verticalFovDeg": { "$ref": "#/$defs/verticalFovDeg" }
      }
    },
    "attribution": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/text", "description": "Plain text; never rendered as HTML." },
        "license": { "$ref": "#/$defs/text" },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "representation": {
      "type": "object",
      "required": ["id", "role", "projection", "mimeType", "encodedBytes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["preview", "immersion"] },
        "projection": { "enum": ["cube", "equirectangular"] },
        "mimeType": { "enum": ["image/jpeg", "image/png"] },
        "encodedBytes": { "$ref": "#/$defs/positiveInteger", "description": "The prepared files' total bytes, six faces summed for a cube." },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "if": { "properties": { "projection": { "const": "cube" } } },
      "then": {
        "required": ["faceSize", "faces"],
        "properties": {
          "id": true, "role": true, "projection": true, "mimeType": true, "encodedBytes": true, "extensions": true,
          "faceSize": { "$ref": "#/$defs/positiveInteger" },
          "faces": {
            "type": "object",
            "description": "Faces named by the format's source axes: X east, Y north, Z up at zero pose. See the cube face table in docs/scenes/format.md.",
            "required": ["px", "nx", "py", "ny", "pz", "nz"],
            "additionalProperties": false,
            "properties": {
              "px": { "$ref": "#/$defs/url" }, "nx": { "$ref": "#/$defs/url" },
              "py": { "$ref": "#/$defs/url" }, "ny": { "$ref": "#/$defs/url" },
              "pz": { "$ref": "#/$defs/url" }, "nz": { "$ref": "#/$defs/url" }
            }
          }
        },
        "additionalProperties": false
      },
      "else": {
        "required": ["width", "height", "url"],
        "properties": {
          "id": true, "role": true, "projection": true, "mimeType": true, "encodedBytes": true, "extensions": true,
          "width": { "$ref": "#/$defs/positiveInteger", "description": "Twice the height: a full 2:1 image." },
          "height": { "$ref": "#/$defs/positiveInteger" },
          "url": { "$ref": "#/$defs/url" }
        },
        "additionalProperties": false
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" }
      },
      "if": { "properties": { "type": { "const": "panorama-image" } } },
      "then": { "$ref": "#/$defs/panoramaAsset" },
      "description": "A panorama-image asset, or a later asset type this version keeps by id only."
    },
    "panoramaAsset": {
      "type": "object",
      "required": ["id", "revision", "type", "colorSpace", "alpha", "attribution", "representations"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/text", "description": "Changes whenever the pixels, the representations or their interpretation change." },
        "type": { "const": "panorama-image" },
        "colorSpace": { "const": "srgb" },
        "alpha": { "const": "opaque" },
        "attribution": { "$ref": "#/$defs/attribution" },
        "representations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/representation" },
          "contains": { "type": "object", "properties": { "role": { "const": "preview" }, "projection": { "const": "cube" } }, "required": ["role", "projection"] },
          "description": "Complete resolutions of one image. At least one is a preview cube."
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "link": {
      "type": "object",
      "required": ["id", "target", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id", "description": "A panorama entity, never a group." },
        "label": { "$ref": "#/$defs/text" },
        "direction": {
          "type": "object",
          "description": "Where the link's hotspot sits in the source panorama's east-north-up view. Without it the link is listed only.",
          "required": ["headingDeg", "pitchDeg"],
          "additionalProperties": false,
          "properties": {
            "headingDeg": { "$ref": "#/$defs/headingDeg" },
            "pitchDeg": { "$ref": "#/$defs/pitchDeg" }
          }
        },
        "arrivalView": { "$ref": "#/$defs/view", "description": "Overrides the destination's initial view for this arrival." },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "required": { "type": "boolean", "description": "A required entity this loader cannot show fails the scene instead of being listed as unsupported." }
      },
      "if": { "properties": { "type": { "const": "panorama" } } },
      "then": { "$ref": "#/$defs/panorama" },
      "description": "A panorama, or a later entity type that a version 1 loader lists as unsupported."
    },
    "panorama": {
      "type": "object",
      "required": ["id", "type", "assetId", "title", "capture", "imagePose", "marker"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "panorama" },
        "assetId": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "capture": {
          "type": "object",
          "required": ["longitudeDeg", "latitudeDeg"],
          "additionalProperties": false,
          "properties": {
            "longitudeDeg": { "$ref": "#/$defs/longitudeDeg" },
            "latitudeDeg": { "$ref": "#/$defs/latitudeDeg" },
            "height": { "$ref": "#/$defs/height" },
            "horizontalAccuracyMeters": { "type": "number", "minimum": 0 }
          }
        },
        "imagePose": {
          "type": "object",
          "description": "Maps image directions to the capture's east-north-up frame: R = Rz(-heading) Rx(pitch) Ry(roll), as GPano.",
          "required": ["headingDeg", "pitchDeg", "rollDeg"],
          "additionalProperties": false,
          "properties": {
            "headingDeg": { "$ref": "#/$defs/headingDeg" },
            "pitchDeg": { "$ref": "#/$defs/pitchDeg" },
            "rollDeg": { "type": "number", "exclusiveMinimum": -180, "maximum": 180 }
          }
        },
        "marker": {
          "type": "object",
          "required": ["mode", "eastM", "northM", "offsetM"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["ground-relative", "capture-relative"], "description": "capture-relative needs a known capture height." },
            "eastM": { "type": "number" },
            "northM": { "type": "number" },
            "offsetM": { "type": "number" },
            "radiusMeters": { "type": "number", "exclusiveMinimum": 0 },
            "style": { "$ref": "#/$defs/markerStyle", "description": "Overrides the scene's markerStyle one property at a time." }
          }
        },
        "initialView": { "$ref": "#/$defs/view" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "required": { "type": "boolean" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "title", "members"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "overview": {
      "type": "object",
      "description": "The view a scene opens at. Heading and pitch describe the camera's forward direction; negative pitch looks down.",
      "required": ["target", "distanceMeters", "headingDeg", "pitchDeg", "verticalFovDeg"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "object",
          "required": ["longitudeDeg", "latitudeDeg"],
          "additionalProperties": false,
          "properties": {
            "longitudeDeg": { "$ref": "#/$defs/longitudeDeg" },
            "latitudeDeg": { "$ref": "#/$defs/latitudeDeg" },
            "height": { "$ref": "#/$defs/height" }
          }
        },
        "distanceMeters": { "type": "number", "exclusiveMinimum": 0 },
        "headingDeg": { "$ref": "#/$defs/headingDeg" },
        "pitchDeg": { "$ref": "#/$defs/pitchDeg" },
        "verticalFovDeg": { "$ref": "#/$defs/verticalFovDeg" }
      }
    },
    "markerStyle": {
      "type": "object",
      "description": "How an orb looks. null turns a property the scene gives off for one marker.",
      "additionalProperties": false,
      "properties": {
        "outline": {
          "description": "A ring just outside the orb's silhouette.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["color", "widthPx"],
              "additionalProperties": false,
              "properties": {
                "color": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$", "description": "A CSS hex colour, #rrggbb or #rrggbbaa." },
                "widthPx": { "type": "number", "minimum": 0, "maximum": 32, "description": "CSS px, whatever the orb's distance." }
              }
            }
          ]
        },
        "hover": {
          "description": "While a pointer is over the orb, it grows; entering still takes a click.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["scale"],
              "additionalProperties": false,
              "properties": {
                "scale": { "type": "number", "minimum": 1, "maximum": 4, "description": "Times the orb's size on screen." }
              }
            }
          ]
        }
      }
    }
  }
}
